sequenceDiagram
    autonumber
      
    actor P as Presentatore  
    participant A as Component A 
    participant C as Catalogo SSU 
    participant B as Component B

   
    Note over A,B: {Component A ,Component B} = (<br/>{FrontOffice,BackOffice} |<br/> {BackOffice,Ente Terzo} <br/>)

   
    Note over A,B: istanza presentata e processo in corso

    alt Comunicazione generica da tra BO(A) ed ET(B)

        opt
            loop Inizio scambio di comunicazioni
                opt        
                    A->>B: send_generic_communication(cui, requester_administration, resource_id)
                    B-->>A: ack
                    A-->>C: audit(cui, communication_to_<ET>_sended)
                    C-->>A: ack
                end
                opt        
                    B->>A: notify(GenericCommunicationMessage)
                    A-->>B: ack
                    B-->>C: audit(cui, communication_sended_from_<ET>)
                    C-->>A: ack
                end
            end
        end
    
    else Comunicazione spontanea dal Presentatore al SUAP

        P-->>A: Invio comunicazione<br/>spontanea
        A->> B: notify(GenericCommunicationMessage)
        B -->> A: ack
        A->> C: audit(cui, communication_fo_to_bo)
        C -->> A: ack

        loop Inizio scambio di comunicazioni
            opt
                B->>A: notify(GenericCommunicationMessage)
                A-->>B: ack
                B-->>C: audit(cui, communication_bo_to_fo)
                C-->>B: ack
            end
            opt
                P-->>A: Invio comunicazione
                A->> B: notify(GenericCommunicationMessage)
                B -->> A: ack
                A->> C: audit(cui, communication_fo_to_bo)
                C -->> A: ack
            end
        end

    end