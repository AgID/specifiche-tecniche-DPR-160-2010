    <bpmn:messageFlow id="MF11" name="ricezione conclusione" sourceRef="M_Throw_11" targetRef="E_Catch_RicezioneConclusione" />
    <bpmn:textAnnotation id="TextAnnotation_1loo5gw">
      <bpmn:text>Può richiedere integrazioni al SUAP o all'Ente Terzo che lo ha coinvolto</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0mx8lb7">
      <bpmn:text>In caso di attivazione dell'Ente Terzo ricorsivo, l'Ente Terzo coinvolto utilizza il lane dell'Ente Terzo e interagisce con l'Ente Terzo che lo ha attivato attraverso uno scambio di messaggi analogo a quello previsto tra SUAP ed Ente Terzo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0im95er">
      <bpmn:text>Invia l'esito al SUAP o all'Ente Terzo che lo ha coinvolto</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
